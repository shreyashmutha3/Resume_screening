# Resume Screener API - Environment Configuration

# [REQUIRED] Your Gemini API Key for embedding and scoring
GEMINI_API_KEY="your_api_key_here"

# [REQUIRED] Authentication Tokens Mapping (JSON format)
# Maps valid API keys to their corresponding orgId, userId, and userRole.
# Roles must be one of: ADMIN, RECRUITER, CANDIDATE
AUTH_TOKENS='{"test-token-admin-123":{"orgId":"demo-org","userId":"admin-user","userRole":"ADMIN"},"test-token-recruiter-123":{"orgId":"demo-org","userId":"recruiter-user","userRole":"RECRUITER"}}'

# [OPTIONAL] Port to run the server on (default: 3000)
# PORT=3000

# [OPTIONAL] Comma-separated list of allowed origins for CORS.
# If unset, no CORS headers are injected, meaning it will default to same-origin.
# Example: ALLOWED_ORIGINS="http://localhost:8080,https://myfrontend.com"
# ALLOWED_ORIGINS=""

# [OPTIONAL] Enable DEV_MODE for testing
# When "true", falls back to trusting x-org-id, x-user-id, and x-user-role headers.
# DO NOT USE IN PRODUCTION.
# DEV_MODE="false"
